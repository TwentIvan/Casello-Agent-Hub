# Botcave web (nome in codice Casello): SPA statica + proxy di /api verso il container API sulla stessa rete Docker di Coolify.
# L'host "casello-api" e' il "Network alias" della risorsa API in Coolify; entrambe le risorse devono
# avere "Connect to predefined network" attivo. Resolver + variabile: nginx parte anche se l'API e' giu'.
resolver 127.0.0.11 valid=10s ipv6=off;

# Coolify termina l'HTTPS su Traefik e qui arriva in http: si inoltra il protocollo originale
# (serve all'API per il cookie di sessione "secure"), con $scheme solo se l'header manca.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        set $api_upstream http://casello-api:3000;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_buffering off;          # SSE / streaming degli agenti
        proxy_read_timeout 3600s;
        # Zip del codice per l'architetto: l'API accetta fino a 50 MB (default nginx: 1 MB)
        client_max_body_size 51m;
    }

    # Webhook in entrata degli inneschi: il segreto e' nel percorso, quindi niente access log; stesso proxy e
    # stessi header di /api/, corpi fino a 256 KB (lo stesso limite dell'API)
    location ^~ /api/hooks/ {
        access_log off;
        set $api_upstream http://casello-api:3000;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 3600s;
        client_max_body_size 256k;
    }

    # Server MCP per gli agenti locali (Claude Code): stesso proxy di /api/, corpi fino a 2 MB
    # (un esito di fase), niente buffering per le risposte in streaming
    location /mcp {
        set $api_upstream http://casello-api:3000;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 3600s;
        client_max_body_size 2m;
    }

    # Connettore OAuth (app Claude): documenti di scoperta e endpoint /oauth/ servono all'API, non alla SPA
    # (^~ batte la fallback di "location /"). Stessi header di /api/; corpi piccoli (default nginx).
    location ^~ /.well-known/oauth- {
        set $api_upstream http://casello-api:3000;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
    }

    location ^~ /oauth/ {
        set $api_upstream http://casello-api:3000;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
    }

    # Pannello incorporabile: si può inserire in un iframe solo dalle origini di EMBED_ALLOWED_ORIGINS
    # (EMBED_ALLOWED_ORIGINS_CSP è calcolata all'avvio da docker/15-embed-origins.envsh; vuota → 'none').
    # Ogni location con add_header propri perde quelli ereditati: la CSP si ripete dove serve.
    # Tenere allineate le due CSP (/embed e /embed/callback). script-src blob: serve all'AudioWorklet di Alfred.
    location = /embed {
        try_files /embed.html =404;
        add_header Content-Security-Policy "frame-ancestors ${EMBED_ALLOWED_ORIGINS_CSP}; default-src 'self'; script-src 'self' blob:; connect-src 'self' wss://generativelanguage.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; worker-src 'self' blob:" always;
        add_header Cache-Control "no-cache" always;
    }

    location = /embed/callback {
        try_files /embed.html =404;
        add_header Content-Security-Policy "frame-ancestors ${EMBED_ALLOWED_ORIGINS_CSP}; default-src 'self'; script-src 'self' blob:; connect-src 'self' wss://generativelanguage.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; worker-src 'self' blob:" always;
        add_header Cache-Control "no-cache" always;
    }

    # Caricatore pubblico botcave.js (le app ospiti lo caricano da un'altra origine)
    location /embed/v1/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=300";
        add_header Access-Control-Allow-Origin "*";
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        # Le pagine della console non si inseriscono in iframe
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
    }

    location = /health { access_log off; return 200 "ok"; add_header Content-Type text/plain; }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
}
